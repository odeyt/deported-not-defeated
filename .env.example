NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Affiliate engine (M-AFFILIATE-1)
# Master switch for the central affiliate engine. Omit or set to "true" to
# enable. Set to "false" to hide every engine-driven recommendation and fall
# back to the legacy affiliate_partners behaviour.
# This flag does not monetize anything on its own: providers ship NOT_APPLIED
# with no affiliate URL, so enabling it adds resource links, not tracking links.
AFFILIATE_ENGINE_ENABLED=true

# Network credentials are NOT required for M-AFFILIATE-1 and none are used yet.
# Add them only after the operator has been approved by that network, and never
# commit real values. Confirm the exact variable names against each network's
# own documentation before wiring them up.
# TRAVELPAYOUTS_MARKER=
# TRAVELPAYOUTS_API_TOKEN=
