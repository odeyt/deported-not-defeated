NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Bypasses Row Level Security — never expose it to the browser.
# Required for affiliate click logging and for reading affiliate URLs once
# supabase/affiliate_engine_m1_hardening.sql has narrowed anonymous access.
# Without it, /go redirects still work; only the analytics write is skipped.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---------------------------------------------------------------------------
# Affiliate engine (M-AFFILIATE-1)
# ---------------------------------------------------------------------------

# Master switch. Unset or "true" = on. Set to "false" to stop emitting any
# affiliate destination; provider websites and non-affiliate fallbacks keep
# working, so no country guide loses its useful links.
AFFILIATE_ENGINE_ENABLED=true

# Click logging, separable from the engine so analytics can be paused for a
# privacy review without taking the recommendations down. Unset = on.
AFFILIATE_CLICK_LOGGING_ENABLED=true

# ---------------------------------------------------------------------------
# Affiliate networks — NOT YET REQUIRED
#
# No network account exists yet, so no network variable is read by any code
# path today. The names below are a placeholder convention only; confirm the
# real variable names and value formats against each network's own publisher
# documentation before adding them, and never commit a real value.
#
# TRAVELPAYOUTS_MARKER=
# TRAVELPAYOUTS_API_TOKEN=
# IMPACT_ACCOUNT_SID=
# AWIN_PUBLISHER_ID=
# ---------------------------------------------------------------------------
